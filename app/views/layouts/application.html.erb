<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · ExamEval" : "ExamEval" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="ExamEval">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600&display=swap" rel="stylesheet">
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand-mark">E</span> ExamEval
        <% end %>
        <span class="tagline">AI evaluation of handwritten Hindi &amp; English answer books</span>
      </div>
    </header>

    <main class="wrap">
      <% if notice %><div class="flash flash-notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash flash-alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>

    <footer class="wrap footer">
      Powered by Meta Muse Spark (reading, grading, moderation) and SAM 3.1 (answer segmentation).
      Every AI mark can be reviewed and overridden by the teacher.
    </footer>
  </body>
</html>
